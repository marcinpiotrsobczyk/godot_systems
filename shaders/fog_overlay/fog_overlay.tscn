[sub_resource type="GDScript" id="GDScript_gi0pj"]
script/source = "extends ColorRect

var uv_dist: Vector2 = Vector2(0, 0);
var noise_speed: Vector2 = Vector2(0.0, 0.0)


func _process(delta: float) -> void:
    _update_noise_speed()
    uv_dist += delta * noise_speed
    material.set_shader_parameter(\"uv_dist\", uv_dist)


func _update_noise_speed() -> void:
   pass


func _on_wind_direction_changed(new_direction: Vector2) -> void:
    noise_speed = new_direction
"

[sub_resource type="GDScript" id="GDScript_p8iwk"]
script/source = "extends ColorRect

signal wind_direction_changed(new_direction: Vector2)

const ZOOM: float = 300.0


func _on_gui_input(event: InputEvent) -> void:
    if event is InputEventMouseButton and event.is_pressed():
        var center: Vector2 = size/2
        var new_direction: Vector2 = (event.position-center)/ZOOM
        wind_direction_changed.emit(new_direction)
"

