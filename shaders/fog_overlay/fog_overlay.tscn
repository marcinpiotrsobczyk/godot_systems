[sub_resource type="Shader" id="Shader_gi0pj"]
code = "shader_type canvas_item;

uniform sampler2D noise_texture: repeat_enable, filter_nearest;
uniform vec2 uv_dist = vec2(1.0, 0.0);


void fragment() {
    vec2 uv = UV + uv_dist;
	float noise = texture(noise_texture, uv).r;
    float fog = clamp(1.8*noise - 1.0, 0.0, 1.0);
    COLOR.a *= fog;
}
"

[sub_resource type="FastNoiseLite" id="FastNoiseLite_gi0pj"]
frequency = 0.0075

